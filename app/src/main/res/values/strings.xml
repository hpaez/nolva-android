<resources>
    <string name="app_name" translatable="false">Nolva</string>
    <!-- Brand wordmark: always lowercase, never translated. -->
    <string name="wordmark" translatable="false">nolva</string>

    <!-- Document list -->
    <string name="new_document">New document</string>
    <string name="empty_title">No documents yet</string>
    <string name="empty_body">Create your first document to start scanning.</string>
    <!-- %1$s: page count (e.g. "3 pages"), %2$s: last updated date -->
    <string name="document_subtitle">%1$s · %2$s</string>
    <plurals name="page_count">
        <item quantity="one">%d page</item>
        <item quantity="other">%d pages</item>
    </plurals>

    <!-- Create document dialog -->
    <string name="document_title_label">Title</string>
    <!-- %1$s: today's date -->
    <string name="default_document_title">Scan %1$s</string>
    <string name="create">Create</string>
    <string name="cancel">Cancel</string>

    <!-- Document detail -->
    <string name="back">Back</string>
    <string name="scan">Scan</string>
    <string name="gallery">Gallery</string>
    <string name="no_pages_title">No pages yet</string>
    <string name="no_pages_body">Scan pages with the camera or add them from your gallery.</string>
    <!-- %1$d: current page, %2$d: total pages -->
    <string name="page_counter" translatable="false">%1$d / %2$d</string>
    <!-- %1$d: 1-based page number -->
    <string name="page_number">Page %1$d</string>

    <!-- Camera -->
    <string name="close">Close</string>
    <string name="done">Done</string>
    <string name="take_photo">Take photo</string>
    <plurals name="pages_captured">
        <item quantity="one">%d page added</item>
        <item quantity="other">%d pages added</item>
    </plurals>
    <string name="camera_permission_title">Camera access needed</string>
    <string name="camera_permission_body">Nolva uses the camera only to scan your documents. Photos stay on your device.</string>
    <string name="grant_permission">Allow camera</string>
    <string name="open_settings">Open settings</string>

    <!-- Errors -->
    <string name="error_load_documents">Couldn\'t load your documents.</string>
    <string name="error_create_document">Couldn\'t create the document.</string>
    <string name="error_invalid_title">That title isn\'t valid.</string>
    <string name="error_load_pages">Couldn\'t load the pages.</string>
    <string name="error_import_page">Couldn\'t add the image.</string>
    <string name="error_capture">Couldn\'t take the photo. Try again.</string>
    <string name="error_unsupported_image">That image format isn\'t supported.</string>
</resources>
