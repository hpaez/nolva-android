<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for Android 12+ (API 31+).

  Documents (filesDir/nolva: the SQLite database and every page image) can
  be sensitive — IDs, contracts, receipts — so they never go to Google's
  cloud backup. They do move in a direct device-to-device transfer, so
  switching phones keeps them without them ever leaving the user's devices.
  Caches are never backed up by the platform.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="nolva/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="nolva/" />
    </device-transfer>
</data-extraction-rules>
